{
  "manifest_version": 3,
  "name": "Web Utilities - Grid Overlay",
  "version": "0.4.0",
  "description": "Browser utilities for inspecting CSS grids and keeping YouTube Music playback moving.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["youtubeMusicAutoContinue.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-grid-overlay": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle CSS grid overlay on the active tab"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "grid-overlay@tsuga.digital",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
